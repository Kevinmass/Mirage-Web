DATABASE_URL=postgresql://mirage:mirage@localhost:5432/mirage
# openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar-esto-por-un-secreto-real-de-32-caracteres-o-mas
BETTER_AUTH_URL=http://localhost:3000

# Zona horaria del proceso (fechas, jobs). En producción va como env var.
TZ=America/Argentina/Buenos_Aires

# Envío de mails (invitaciones, verificación, recuperar contraseña). Sin
# esto los mails quedan encolados y fallan al intentar salir — el resto de
# la app funciona igual. Dominio verificado en Resend para mandar desde
# no-reply@miragesoftware.com.ar; en pruebas, Resend solo entrega a la
# casilla dueña de la API key.
RESEND_API_KEY=

# Habilita la ruta /setup (arranque en frío desde el navegador, sin SQL a
# mano). /setup responde SOLO si la tabla persona está vacía Y el request
# trae ?token= con este valor. Poné algo largo y al azar. Dejalo vacío para
# deshabilitar la ruta por completo.
SETUP_TOKEN=

# Token fino de solo lectura de la org, para la actividad de GitHub de los
# proyectos. Sin esto, esa sección devuelve 403.
GITHUB_TOKEN=
